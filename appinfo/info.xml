<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nc_wireguard</id>
	<name>NC WireGuard</name>
	<summary>Control and monitor WireGuard VPN peers inside Nextcloud</summary>
	<description><![CDATA[Peer controller and metrics for a wg-easy WireGuard engine: create/edit peers, bandwidth history, connection events, optional GeoIP map, and server metrics inside Nextcloud.

Not affiliated with or endorsed by WireGuard or wg-easy. WireGuard is a registered trademark of Jason A. Donenfeld.

Optional NC-GCS theming when that app is installed; works standalone without NC-GCS. Admin-only access.]]></description>
	<version>2.1.0</version>
	<licence>agpl</licence>
	<author mail="dan@19labs.com">19labs</author>
	<namespace>NcWireguard</namespace>
	<category>tools</category>
	<website>https://github.com/vdroners/nc-wireguard</website>
	<bugs>https://github.com/vdroners/nc-wireguard/issues</bugs>
	<repository type="git">https://github.com/vdroners/nc-wireguard.git</repository>
	<documentation>https://github.com/vdroners/nc-wireguard/blob/main/README.md</documentation>
	<screenshot>https://raw.githubusercontent.com/vdroners/nc-wireguard/main/docs/screenshots/overview.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/vdroners/nc-wireguard/main/docs/screenshots/map.png</screenshot>
	<dependencies>
		<php min-version="8.1" max-version="8.4"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<lib>curl</lib>
		<nextcloud min-version="28" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<name>NC WireGuard</name>
			<route>nc_wireguard.page.index</route>
			<icon>app.svg</icon>
			<order>74</order>
		</navigation>
	</navigations>
	<background-jobs>
		<job>OCA\NcWireguard\BackgroundJob\MetricsHealthJob</job>
	</background-jobs>
	<commands>
		<command>OCA\NcWireguard\Command\SchemaCheckCommand</command>
		<command>OCA\NcWireguard\Command\PollMetricsCommand</command>
		<command>OCA\NcWireguard\Command\PruneMetricsCommand</command>
		<command>OCA\NcWireguard\Command\ImportSidecarDbCommand</command>
		<command>OCA\NcWireguard\Command\VerifyImportCommand</command>
	</commands>
	<settings>
		<admin>OCA\NcWireguard\Settings\AdminSettings</admin>
		<admin-section>OCA\NcWireguard\Settings\AdminSection</admin-section>
	</settings>
</info>

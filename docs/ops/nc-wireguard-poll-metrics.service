[Unit]
Description=NC WireGuard native metrics poll (single cycle)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
# Adjust path to your Nextcloud install (cloud_app container uses occ inside)
ExecStart=/usr/bin/docker exec cloud_app php occ nc_wireguard:poll-metrics
Nice=10

[Install]
WantedBy=multi-user.target

# Copy to .env.lab (git-ignored) before starting the lab stack.
#
#   openssl rand -hex 32
#
# The same value goes into Nextcloud:
#   docker exec cloud_app php occ config:app:set nc_wireguard wg_sync_token --value '<token>'
WG_SYNC_TOKEN=

# Optional: DEBUG logs every wg/ip invocation (never key material).
WG_SYNC_LOG_LEVEL=INFO

# Optional: allow /health without a bearer token so a container healthcheck or
# an operator curl can see liveness. /apply, /dump, /reload always require it.
WG_SYNC_HEALTH_PUBLIC=0
